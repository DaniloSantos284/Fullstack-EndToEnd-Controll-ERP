# Valores deliberadamente fictícios para desenvolvimento e testes locais.
# Nunca use este arquivo em staging ou produção.
DB_ROOT_PASSWORD=mock-root-only
DB_PASSWORD=mock-app-only
DB_DATABASE=stockdb
DB_USER=stock_user
DB_CONNECTION_LIMIT=10

PORT_APP=4000
DB_PUBLISHED_PORT=3307
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT_KB=64
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SHUTDOWN_TIMEOUT_MS=10000

# Valores sintaticamente válidos para iniciar o overlay do gateway.
# Para validar JWT de verdade, aponte JWT_JWKS_URL a um emissor/JWKS de teste acessível.
JWT_ISSUER=https://issuer.example.test
JWT_AUDIENCE=stock-api
JWT_JWKS_URL=https://issuer.example.test/.well-known/jwks.json
JWT_READ_SCOPE=inventory:read
JWT_WRITE_SCOPE=inventory:write
PUBLIC_HOSTNAME=api.example.test
FRONTEND_ORIGIN=https://app.example.test
GATEWAY_PORT=8443
TLS_CERT_PATH=
TLS_KEY_PATH=

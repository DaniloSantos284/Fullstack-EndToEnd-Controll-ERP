{
  "name": "stock",
  "version": "1.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "description": "Sistema de estoque com Node.js, TypeScript e MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "start": "node dist/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --coverage",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --ci --runInBand --coverage",
    "test:gateway": "tsx tests/integration/nginx-gateway.ts",
    "test:integration": "tsx tests/integration/mysql-stock.ts",
    "test:typecheck": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mysql2": "^3.9.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "tsx": "^4.15.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  }
}

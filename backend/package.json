{
  "name": "stock",
  "version": "1.0.0",
  "packageManager": "pnpm@12.6.0",
  "description": "Sistema de estoque com Node.js, TypeScript e MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:ci": "jest --config jest.config.cjs --ci --runInBand --coverage",
    "test:typecheck": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "mysql2": "^3.9.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "tsx": "^4.15.7",
    "typescript": "^5.9.3"
  }
}

# Copy to .env for local Compose. Set nonempty, private passwords before starting.
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_DATABASE=stockdb
DB_USER=stock_user
DB_CONNECTION_LIMIT=10

# Only docker-compose.local.yml publishes the API to loopback.
PORT_APP=4000
# Used only with docker-compose.db-port.yml.
DB_PUBLISHED_PORT=3307

# Trust one reverse proxy only after its network path is restricted.
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT_KB=64
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SHUTDOWN_TIMEOUT_MS=10000

# Required when running docker-compose.gateway.yml. Obtain these from an OIDC provider.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_READ_SCOPE=inventory:read
JWT_WRITE_SCOPE=inventory:write
PUBLIC_HOSTNAME=
# Set for a browser frontend hosted on a different origin (for example, https://app.example.com).
FRONTEND_ORIGIN=
TLS_CERT_PATH=
TLS_KEY_PATH=
GATEWAY_PORT=443
